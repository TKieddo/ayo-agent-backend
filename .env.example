# === Required ===
DEEPSEEK_API_KEY=sk-your-deepseek-key
EXCHANGE=okx

# === OKX (demo) ===
OKX_DEMO=true
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_LEVERAGE=10

# === Pair Hunter ===
# Scans Binance heat for opportunity scoring, then keeps ONLY symbols listed
# as live USDT-SWAP on OKX (when EXCHANGE=okx). Non-OKX memes are dropped.
ENABLE_PAIR_HUNTER=true
PAIR_HUNTER_TOP_N=5
PAIR_HUNTER_MIN_VOLATILITY=1.0
PAIR_HUNTER_IDEAL_VOLATILITY=2.0
PAIR_HUNTER_MAX_VOLATILITY=3.5
PAIR_HUNTER_MIN_VOLUME_24H=50000000
PAIR_HUNTER_MIN_TREND_STRENGTH=25
CRYPTO_ASSETS=BTC ETH SOL
# Stocks (Alpaca only — never falls back to OKX). Leave empty until Alpaca is wired.
# STOCK_ASSETS=AAPL TSLA NVDA MSFT
# Hard-split: CRYPTO_ASSETS → okx/binance/aster only; STOCK_ASSETS → alpaca only;
# FOREX_ASSETS → ig only. No cross-venue fallback.

# === Exits (mechanical; agent does not manage exits) ===
AGENT_MANAGE_EXITS=false
INTERVAL=15m
EXIT_CHECK_SECONDS=20
# EXIT_MODE controls the STOP only. ATR = stop = SL_ATR_MULT x ATR% of price
# (clamped to MIN/MAX_STOP_PRICE_PCT). Fixed = STOP_LOSS_PERCENT as margin ROI.
EXIT_MODE=atr
SL_ATR_MULT=2.0
ATR_PERIOD=14
MIN_STOP_PRICE_PCT=0.6
MAX_STOP_PRICE_PCT=4.0
# Take-profit is independent of the stop:
#   TP_MODE=roi_percent   → close when margin ROI hits TAKE_PROFIT_PERCENT (OKX % PnL; at 10x, 7% ≈ 0.7% price) ← use this
#   TP_MODE=price_percent → close when PRICE moves TAKE_PROFIT_PERCENT % (5 = +5% of entry)
#   TP_MODE=usd           → close when unrealized PnL hits TAKE_PROFIT_USD (e.g. 5)
#   TP_MODE=atr_rr        → legacy: target = TP_RR_RATIO x ATR stop (often 10–14% — ignores the % field)
TP_MODE=roi_percent
TAKE_PROFIT_PERCENT=7
TAKE_PROFIT_USD=
TP_RR_RATIO=2.5
STOP_LOSS_PERCENT=10
ENABLE_BREAKEVEN_STOP=true
BREAKEVEN_TRIGGER_R=1.0
ENABLE_TRAILING_STOP=true
TRAILING_STOP_ACTIVATION_R=1.5
TRAILING_STOP_DISTANCE_R=1.0

# === Position sizing ===
# "margin": fixed MARGIN_PER_POSITION (e.g. $30) × leverage = notional. Use this for steady size.
# "risk": shrinks/grows size so ATR stop ≈ RISK_PER_TRADE_USD (can look like $12 margin).
# === Position sizing (choppy pairs) ===
# "risk": wide ATR stop (up to ~7%) + shrink margin so a stop still ≈ RISK_PER_TRADE_USD.
# "margin": fixed $30 — cannot also have a 7% stop and only $6 loss (math conflict).
POSITION_SIZING_MODE=risk
MARGIN_PER_POSITION=30
RISK_PER_TRADE_USD=6
RISK_PER_TRADE_PCT=0.5
# Gap/slippage buffer (~1.5× risk). ATR is the real stop — do not set this to -6 with wide ATR.
STOP_LOSS_USD=-6
EXIT_MODE=atr
MIN_STOP_PRICE_PCT=1.5
MAX_STOP_PRICE_PCT=7.0
DEFAULT_LEVERAGE=10
MAX_POSITIONS=3

# === Re-entry control (anti-chop) ===
REENTRY_COOLDOWN_MINUTES=45
LOSS_REENTRY_COOLDOWN_MINUTES=90
BLOCK_DIRECTION_FLIP=true

# === Skip DeepSeek when flat assets have no usable indicators (mechanical TP/SL still runs) ===
SKIP_LLM_WITHOUT_MARKET_DATA=true

# === Supabase (Coolify self-hosted or cloud) ===
# Studio → Settings → API
SUPABASE_URL=https://your-kong-or-api-domain
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# === OKX crypto + IG forex (Coolify) ===
# Hard-split routing: crypto never trades on Alpaca/IG; stocks never on OKX; forex never on OKX/Alpaca.
# Unmapped assets are skipped (no fallback). Set MULTI_EXCHANGE_MODE=true OR leave it false —
# multi-exchange auto-enables when OKX + IG credentials + FOREX_ASSETS are all present.
MULTI_EXCHANGE_MODE=true
# Pause all forex analysis/trading (set true again when IG API key allowance recovers)
ENABLE_FOREX=false
IG_DEMO=true
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
# Optional preferred IG account / epic overrides
# IG_ACCOUNT_ID=
# IG_EPIC_MAP=EURUSD:CS.D.EURUSD.MINI.IP,GBPUSD:CS.D.GBPUSD.MINI.IP
FOREX_ASSETS=EURUSD GBPUSD AUDUSD USDJPY
# Forex-specific knobs (override crypto defaults for FX pairs only)
FOREX_INTERVAL=15m
FOREX_LEVERAGE=20
# FOREX_RISK_PER_TRADE_USD=5
# FOREX_EXIT_MODE=atr
# FOREX_SL_ATR_MULT=1.5
# FOREX_TP_RR_RATIO=2.0

# === Runtime ===
API_HOST=0.0.0.0
APP_PORT=8080
PORT=8080
